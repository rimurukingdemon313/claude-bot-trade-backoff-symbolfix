# ===========================================================================
# TradeLocker — DEMO ONLY
# ===========================================================================
# This build refuses to start against a live endpoint and refuses to send an
# order unless the account positively identifies itself as DEMO. There is no
# environment variable that disables that check.
TRADELOCKER_EMAIL=you@example.com
TRADELOCKER_PASSWORD=your-tradelocker-password
TRADELOCKER_SERVER=YOURSERVER
TRADELOCKER_ACC_ID=1234567
TRADELOCKER_URL=https://demo.tradelocker.com/backend-api

# ===========================================================================
# Execution mode  —  THE MOST IMPORTANT SETTING
# ===========================================================================
#   paper      Orders are SIMULATED against live broker prices. Nothing is
#              sent to TradeLocker. Every other stage is the real path, so a
#              paper run is evidence about the live path. START HERE.
#   demo_live  Real orders on your TradeLocker DEMO account.
#
# There is no third value. LIVE is not a mode this build has.
TRADING_MODE=paper

# Paper fill modelling. Defaults are pessimistic on purpose: a simulator
# that fills at the mid with no costs reports a performance the demo account
# could never reproduce.
# Leave PAPER_STARTING_BALANCE unset to adopt the real account balance, so
# paper results are scaled to the account being validated.
# PAPER_STARTING_BALANCE=10000
PAPER_ENTRY_SLIPPAGE_TICKS=2
PAPER_STOP_SLIPPAGE_TICKS=4
PAPER_COMMISSION_PER_LOT=7

# ===========================================================================
# Persistence
# ===========================================================================
# Set DATABASE_URL on Railway. Without it the bot falls back to SQLite at
# SQLITE_PATH, which does NOT survive a redeploy on an ephemeral filesystem —
# meaning the kill switch, daily-loss counters and drawdown state reset.
# DATABASE_URL=postgresql://user:password@host:5432/database
SQLITE_PATH=data/bot.db

# ===========================================================================
# AI validation (optional)
# ===========================================================================
# AI can only VETO a trade the deterministic engine already produced. It can
# never create one, change direction, move a level, or alter risk.
# Leave both blank to run fully deterministically.
# IMPORTANT: if AI_ENABLED=true and BOTH keys are empty and
# AI_ALLOW_TRADE_WITHOUT_AI=false, every setup is rejected at the AI gate and
# the bot NEVER opens a trade. If you have no keys, set AI_ENABLED=false.
GEMINI_API_KEY=
GROQ_API_KEY=
AI_ENABLED=false
AI_MIN_CONFIDENCE=70
# If every provider fails, should the deterministic pipeline stand alone?
# Default false = no trade.
AI_ALLOW_TRADE_WITHOUT_AI=false

# ===========================================================================
# Symbols
# ===========================================================================
# Either form works. Many brokers decorate their instrument names
# (EURUSD.R, EURUSD_i, EURUSDm, EURUSD.pro); the bot resolves the decoration
# and uses the canonical pair as the identity for duplicate detection, the
# per-symbol limit, news blackouts and correlation, while calling the API
# with the broker's exact name.
#
#   TRADED_SYMBOLS=EURUSD,GBPUSD,XAUUSD        <- bare pairs
#   TRADED_SYMBOLS=EURUSD.R,GBPUSD.R,XAUUSD.R  <- your broker's exact names
#
# Use the exact names only if your account lists TWO variants of the same
# pair (e.g. EURUSD.R and EURUSD.RAW) — the bot refuses to guess between them.
# Run `python3 -m bot.doctor` to see which naming your account uses.
#
# Instruments that are not currency pairs (US500, NAS100, WTI) have no
# determinable quote currency and are skipped rather than mis-sized.
TRADED_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCHF,XAUUSD

# ===========================================================================
# Risk (hard ceilings — the build refuses values above its own limits)
# ===========================================================================
RISK_BASE_PCT=0.005          # 0.5% of equity on a normal setup
RISK_MIN_PCT=0.0025
RISK_MAX_PCT=0.01            # absolute per-trade ceiling
RISK_MAX_PORTFOLIO_PCT=0.03
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_TRADES_PER_DAY=6
# The minimum structural reward:risk. The build floor is 1:1 - below
# parity a winner is worth less than a loser costs, and no hit rate this
# system can honestly claim recovers that.
#
# Lowering this raises WIN RATE and lowers the payoff, and the two do not
# cancel in your favour. Measured on 12 symbols, 27 days, moving the
# target and nothing else:
#
#   target    n     win     final balance (from $5,000)
#   1.20R    180   33.3%    $4,555
#   0.80R    193   49.7%    $5,027
#   0.515R   199   57.8%    $5,060   <- best balance
#   0.40R    204   58.8%    $4,906
#   0.30R    213   62.4%    $4,782
#   0.25R    220   63.6%    $4,731   <- highest win rate, second-worst balance
#
# Win rate climbs the whole way. The balance peaks in the middle and
# falls off both sides, because the average WIN collapsed from $20.54 to
# $9.74 while the average LOSS never moved from about -$20.
#
# Every extra win was bought with a smaller win. And none of the positive
# rows is statistically significant - +$59.56 carried a +/-$508 interval,
# and 0.515 winning while 0.40 loses is the shape of noise, not of a
# mechanism. Do not set this chasing a win rate.
RISK_MIN_RR=1.2

# ---------------------------------------------------------------------------
# HOW OFTEN IT MAY TRADE
# ---------------------------------------------------------------------------
# These are FREQUENCY caps. Raising them lets the bot act more often; it
# does NOT let it lose more, because the money caps below are separate
# and unchanged by anything here.
#
# The session cap is the tighter of the two and binds first: at the
# default of 3, raising only the daily limit changes nothing.
RISK_MAX_TRADES_PER_SESSION=3
RISK_MAX_TRADES_PER_DAY=6
RISK_MAX_OPEN_POSITIONS=3

# These are the MONEY caps, and they are what actually protects the
# account. They feed the kill switch. Nothing in the frequency block
# above touches them, whatever it is set to.
#
#   RISK_MAX_DAILY_LOSS_PCT   3%  of balance  -> stops the day
#   RISK_MAX_DRAWDOWN_PCT    10%  from peak   -> stops trading
#   base risk per trade      0.5% of equity
#
# So the worst case is bounded by the money caps and the per-trade risk,
# not by the trade count. Six trades at 0.5% cannot lose more than the
# 3% daily limit allows, and neither can thirty.

# ===========================================================================
# Reward objective
# ===========================================================================
# A FILTER, not a target, and measured in R rather than in dollars.
#
# This used to be OPPORTUNITY_MINIMUM_PROFIT=40 / TARGET_PROFIT=50, and a
# dollar floor turns out to be a statement about ACCOUNT SIZE rather than
# about setup quality. Expected profit at the target is
#
#     risk x R          and risk is a fixed % of equity
#
# so a $40 floor quietly demanded 1:2 on a $5,000 account and 1:4 on a
# $1,000 one. The market does not know your balance; the same chart must
# not grade differently on two accounts.
#
# MIN_R is the floor a setup must clear. PREFERRED_R is only a label - a
# setup at or above it is reported as strong, and nothing is refused for
# missing it. The structure sets the stop and the target, so the ratio is
# whatever the nearest opposing liquidity is worth: it is never improved
# by sizing up, tightening the stop, or moving the target.
REWARD_MIN_R=1.2
REWARD_PREFERRED_R=1.5
REWARD_ENABLED=true

# ===========================================================================
# Stop width, and why it is a cost control
# ===========================================================================
# A setup whose structural stop is tighter than RISK_MIN_STOP_ATR is
# REJECTED. Raising this never widens a stop; it declines the trade.
#
# It belongs next to the cost settings because of one piece of algebra:
#
#     lots = risk / (stop_distance x contract)
#     cost = spread x contract x lots
#          -> cost/risk = spread / stop_distance      (contract cancels)
#
# So a tight stop does NOT reduce what a trade pays the broker. It
# magnifies it as a share of the risk. Measured across four settings on
# 12 generated symbols:
#
#     0.35 ATR   n=180   win 33.3%   PF 0.73   friction 16.6% of R
#     0.60 ATR   n=146   win 34.2%   PF 0.84   friction 14.1%
#     0.90 ATR   n= 85   win 36.5%   PF 0.88   friction 10.7%
#     1.30 ATR   n= 30   win 46.7%   PF 1.15   friction  8.2%
#
# Win rate, profit factor and expectancy all improved monotonically. But
# the far end had 30 trades and a confidence interval that spans zero
# (+0.142R +/- 0.434, which is 0.64 sigma - NOT significant), so the
# default has not moved.
#
# The friction column is certain, because it is arithmetic. The rest is
# suggestive. Run 0.9 on PAPER and let your own history decide.
RISK_MIN_STOP_ATR=0.35
RISK_MAX_STOP_ATR=3.5

# ---------------------------------------------------------------------------
# A NOTE ON EVERY TUNABLE BELOW AND ABOVE
# ---------------------------------------------------------------------------
# Changing any of them changes what the bot trades, so the build version
# constants alone would no longer identify the behaviour that produced a
# trade - which is the exact failure project rule 9 exists to prevent.
#
# So every trade, decision and journal row records a TUNING FINGERPRINT
# alongside the version tuple: "default" on a stock build, or
# "tuned-xxxxxxxx" when anything here is overridden. The full list of
# overrides is logged once at startup, so the digest can be read back.
#
# This is what makes "run it on PAPER and let your own history decide"
# an actual experiment: group your closed trades by the fingerprint and
# the experiment and the control are separable. Without it they are one
# undifferentiated pile.
#
# The fingerprint covers scoring, risk, execution, MTF and reward. It
# never touches a credential, a URL or the database.

# ===========================================================================
# Scoring
# ===========================================================================
# A setup must reach SCORING_MIN_TRADEABLE to be taken at all.
#
# This is the knob worth knowing about. Measured over 180 simulated
# trades on generated M15:
#
#     A grade   n= 54   win 46.3%   avgR +0.014
#     B grade   n=119   win 28.6%   avgR -0.152
#
# The entire loss lived in the B cohort. But the correlation between the
# CONTINUOUS score and the outcome was +0.037 - near enough to nothing -
# so the A/B boundary is doing real work while the arithmetic that
# produces the number ranks almost at random.
#
# That is one dataset, and a generated one, so the default has NOT moved.
# Raising this to 68 (tier A) is the single most promising experiment
# available: it would cut roughly 70% of the trades. Run it on PAPER and
# let your own trade history decide.
SCORING_MIN_TRADEABLE=56
SCORING_TIER_B=56
SCORING_TIER_A=68
SCORING_TIER_A_PLUS=80

# ===========================================================================
# Position management
# ===========================================================================
# Break-even and the structural exit are ON because they are simple and
# tested. TRAILING is OFF and the project rule is that it must be EARNED
# by testing rather than switched on because it sounds sophisticated.
#
# PARTIALS went through exactly that procedure and are now ON at 0.75R.
# See docs/EXPERIMENT_WIN_RATE.md for the whole thing: a selection rule
# committed before the results were read, ten configurations, one
# promoted, and a held-out seed set that chose nothing. On that held-out
# data, against the previously shipped configuration:
#
#     win rate     25.4%  ->  44.5%
#     avgR        -0.248  -> -0.128
#     max DD      521.70  ->  442.74
#
# The control's drawdown breached the 10% limit and its own risk engine
# refused 93 setups; the candidate's never did. And 29 of the candidate's
# wins exited at STOP and were still net positive, because the partial
# was banked before price came back - the mechanism, visible in the exit
# reasons rather than asserted.
#
# It is still NEGATIVE, on both datasets, and both are synthetic. This
# buys a smaller loss and a smoother curve, not a profit. Reversing it is
# one line: EXEC_ENABLE_PARTIAL_TP=false.
#
# They are here so that rule can actually be followed: run them on PAPER
# for a couple of weeks, compare the trade history, and turn them off
# again without redeploying code. Do not enable them on the strength of
# one backtest - a synthetic price series is not a market, and a result
# that only exists on one dataset is a curve fit with a confidence
# interval.
#
# ---------------------------------------------------------------------------
# WHAT WAS MEASURED
# ---------------------------------------------------------------------------
# Six configurations over the SAME 12 symbols x 2600 M15 bars, same seeds,
# so the price data is identical in every run and the comparison is
# paired. Costs: 8 ticks spread, 3 ticks slippage, $7/lot.
#
#   config                       n   win     PF     avgR   maxDD  scratch
#   A  nothing at all          176  38.1%  0.837  -0.110  451.69       1
#   B  SHIPPED (BE + struct)   180  33.3%  0.728  -0.111  444.84      32
#   C  B + partial 50% @1.5R   180  35.6%  0.733  -0.107  440.82      27
#   D  C + trailing            183  35.5%  0.726  -0.109  458.12      28
#   E  B + trailing            183  33.9%  0.729  -0.110  450.52      31
#   F  B + partial 50% @1.0R   180  51.1%  0.866  -0.058  343.96       0
#
# Read it in this order:
#
# 1. EVERY configuration loses money. None of these is a fix, and none
#    of them turns a negative edge positive. Whatever you enable, the
#    system is still negative on this data.
#
# 2. A -> B turns on BOTH shipped features together (break-even and the
#    structural exit), so it measures the pair, not break-even alone.
#    The pair does nothing for expectancy: -0.110R becomes -0.111R.
#    What it does is convert 31 trades that were going somewhere into
#    scratches, which is why the win rate and the profit factor FALL.
#    Both are on by default and neither is earning its place on this
#    evidence - together they are neutral, and they cost win rate.
#
# 3. A partial at 1.5R (C) and trailing (E) both change essentially
#    nothing. They are off, and this is why.
#
# 4. A partial at 1.0R (F) is the only setting that moves anything:
#    win rate +17.8 points, average R roughly halved, maximum drawdown
#    down 23%. The mechanism is not subtle - most trades that reach 1R
#    never reach the target, so banking half at 1R turns them from
#    scratches and losses into partial wins.
#
# That table was the FIRST pass and it ended here: "the default has not
# been moved, because one synthetic dataset is not evidence enough".
# A proper experiment was then run - docs/EXPERIMENT_WIN_RATE.md - which
# swept the partial level rather than testing one, fixed its selection
# rule before reading any result, and validated on held-out seeds. It
# landed on 0.75R rather than the 1.0R this table suggested, and THAT is
# why the default moved. The rows above stand as measured; they were
# just not enough on their own to move anything.
EXEC_ENABLE_BREAKEVEN=true
EXEC_ENABLE_STRUCTURE_EXIT=true
EXEC_ENABLE_PARTIAL_TP=true
EXEC_ENABLE_TRAILING=false

# Where each one triggers, in R. A partial at 0.75R takes
# EXEC_PARTIAL_TP_FRACTION off the position and lets the rest run.
# 0.75 is the tested level; 1.5, the old default, measured no better
# than taking no partial at all.
EXEC_BREAKEVEN_AT_R=1.0
EXEC_PARTIAL_TP_AT_R=0.75
EXEC_PARTIAL_TP_FRACTION=0.5
EXEC_TRAIL_AFTER_R=2.0

# A position open this long without reaching 0.5R has outlived its thesis.
EXEC_MAX_POSITION_HOURS=48

# ===========================================================================
# Scheduling
# ===========================================================================
SCAN_INTERVAL_MINUTES=15
POSITION_POLL_SECONDS=30
RECONCILE_INTERVAL_SECONDS=300
TRADING_ENABLED_DEFAULT=true
NEWS_FILTER_ENABLED=true

# ===========================================================================
# Server
# ===========================================================================
PORT=5000
BOT_PORT=8787
LOG_LEVEL=info
# Print the read-only account verification into the logs on every boot, so it
# can be read without a terminal. Set false to skip it.
STARTUP_DOCTOR=true
# Protects every control that can START trading: clearing the kill switch,
# resuming the scanner, switching strategy, running a manual scan. Without
# it those controls are DISABLED — the deployment is reachable by anyone
# who learns its hostname, and hostnames are published in certificate
# transparency logs. Stopping the bot never needs it.
# Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=
# Only set if the dashboard is served from a different origin than the API.
# Empty = same-origin only, which is what a single Railway service wants.
DASHBOARD_ORIGINS=
