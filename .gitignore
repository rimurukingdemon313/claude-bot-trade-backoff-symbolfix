# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Runtime data — generated at runtime, never committed.
# data/ holds the SQLite fallback database and the news-feed cache.
# Neither is source, and bot.db contains real account history.
data/
*.db
*.db-wal
*.db-shm
economic_calendar_cache.json
__pycache__/
*.pyc
.pytest_cache/

# Secrets. Never commit a filled-in environment file.
.env
.env.*
!.env.example

# Output of scripts/setup.sh / bot.doctor. Masked with --safe, but it still
# describes a specific account — not source.
doctor-report.txt

# Build output generated at container startup by index.js (esbuild bundles
# server/index.ts into here) — not source, should not be committed.
.runtime/
