{
  "name": "smc-trading-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "node index.js",
    "typecheck": "tsc --noEmit",
    "bot": "python3 -m bot.service",
    "test": "python3 -m pytest && node --test \"tests/server/*.test.mjs\"",
    "test:py": "python3 -m pytest",
    "verify": "npm run typecheck && npm run build && npm run test",
    "setup": "bash scripts/setup.sh",
    "doctor": "python3 -m bot.doctor --safe",
    "test:server": "node --test \"tests/server/*.test.mjs\"",
    "smoke": "node tests/browser/dashboard-smoke.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "esbuild": "^0.27.7",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.6",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "description": "Autonomous SMC trading system for a TradeLocker DEMO account, with a mobile-first dashboard.",
  "engines": {
    "node": ">=20"
  }
}
